[sub_resource type="GDScript" id="GDScript_xo5yo"]
script/source = "extends Node2D

var game_ended: bool = false

func _ready() -> void:
	# Tiempo límite de supervivencia al estilo WarioWare
	await get_tree().create_timer(4.0).timeout
	if not game_ended:
		game_ended = true
		get_parent().end_microgame(true)

# Esta función la llamará el spawner si chocamos con un \"cero\"
func game_over() -> void:
	if not game_ended:
		game_ended = true
		get_parent().end_microgame(false)
"

